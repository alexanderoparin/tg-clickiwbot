# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF
# Telegram user_id через запятую, кому разрешён доступ.
# Пусто — бот открыт для всех (действуют лимиты из config.py)
ALLOWED_USER_IDS=111111111,222222222
# Админы: команда /stats. Всегда имеют доступ
ADMIN_IDS=111111111
# Каталог для БД и загруженных файлов
DATA_DIR=data
# Ссылка на политику обработки персональных данных (показывается при запросе контакта).
# Пусто — строка со ссылкой не показывается
PRIVACY_URL=
# Уведомлять админов о новом пользователе (true/false)
NOTIFY_NEW_USERS=true
