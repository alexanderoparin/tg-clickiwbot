# /etc/systemd/system/wb-drr-bot.service
[Unit]
Description=WB DRR Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wbbot
WorkingDirectory=/opt/wb-drr-bot
ExecStart=/opt/wb-drr-bot/.venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
